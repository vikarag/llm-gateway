# Required: upstream OpenRouter key.
# A key with a per-key spend limit is recommended — anything that can reach the
# gateway can spend against it unless you also set PROXY_API_KEY.
OPENROUTER_API_KEY=

# Model used when a request omits "model".
# DEFAULT_MODEL=deepseek/deepseek-v4.1-flash-1017

# Listen port (default 9302) and optional explicit bind addresses.
# GATEWAY_PORT=9302
# GATEWAY_HOSTS=127.0.0.1

# Routing table: JSON map or Hermes-style YAML. Without it, requests pass through.
# GATEWAY_ROUTING_FILE=/home/you/.config/llm-gateway/routing.json

# Require a shared secret from clients instead of trusting the network.
# PROXY_API_KEY=change-me
